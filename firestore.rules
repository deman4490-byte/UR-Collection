rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Products Collection: Public read, Admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null; // Restrict write to authenticated store admins
    }

    // 2. Orders Collection: Authenticated customers can read/write their own orders
    match /orders/{orderId} {
      allow create: if true; // Allow guest & customer checkout
      allow read: if request.auth != null && (request.auth.uid == resource.data.customerId || request.auth.token.admin == true);
      allow update, delete: if request.auth != null && request.auth.token.admin == true; // Admin status updates
    }

    // 3. Settings Document: Public read (for Shop Name & Address), Admin write
    match /settings/store_config {
      allow read: if true;
      allow write: if request.auth != null; // Admin write only
    }
  }
}
